# Configuration Strava
# Obtenez ces valeurs depuis https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_client_id_here
STRAVA_CLIENT_SECRET=your_client_secret_here
# Tokens initiaux (générés par get_strava_tokens.py, ensuite rafraîchis
# automatiquement et persistés dans data/.strava_token.json)
STRAVA_ACCESS_TOKEN=your_access_token_here
STRAVA_REFRESH_TOKEN=your_refresh_token_here
STRAVA_TOKEN_EXPIRES_AT=0

# Configuration Garmin Connect
GARMIN_EMAIL=your_garmin_email@example.com
GARMIN_PASSWORD=your_garmin_password
# Optionnel: emplacement des tokens Garmin (défaut: data/.garminconnect)
# GARMIN_TOKENS_FILE_LOC=data/.garminconnect

# Configuration de l'application
DRY_RUN=false                # true = simulation, aucune modification sur Strava
SYNC_INTERVAL_MINUTES=60     # Intervalle entre deux synchronisations
SYNC_DAYS=7                  # Nombre de jours d'activités à synchroniser
RUN_MODE=scheduler           # 'scheduler' (continu) ou 'once' (exécution unique)
LOG_LEVEL=INFO               # DEBUG pour plus de détails

# Fenêtre d'heures creuses (aucune sync entre start et end, heure locale SYNC_TZ)
SYNC_TZ=Europe/Brussels
QUIET_HOURS_START=0
QUIET_HOURS_END=6

# Page de statut HTTP (0 pour désactiver)
STATUS_PORT=8080
# Le /health passe en erreur si aucun sync depuis N secondes
STATUS_MAX_AGE_SECONDS=10800

# Timezone du conteneur
TZ=Europe/Brussels
